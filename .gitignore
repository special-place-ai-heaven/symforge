/target
# Custom CARGO_TARGET_DIR variants (e.g. target-wsl on dual Windows/WSL setups).
/target-*/

# Root-level tool and harness state directories.
/.*/
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/.github/

# Cursor plugin manifest (marketplace / Grok Bot). Root `/.*/` would
# otherwise ignore this directory and the logo would never reach GitHub.
!/.cursor-plugin/

# Spec Kit: tracked so `git worktree add` carries the templates, scripts and
# constitution into every worktree. .specify/.gitignore (shipped by the CLI)
# excludes the per-checkout bits like feature.json.
!/.specify/

# Claude Code: share the skills (incl. speckit-*), keep local state out.
!/.claude/
/.claude/*
!/.claude/skills/

# Nested SymForge local cache (e.g. npm/.symforge/) — local state, never tracked.
**/.symforge/

# Grok CLI per-project MCP working dir (created during dogfooding) — not repo content.
/mcps/

npm/*.tgz
.env*
*.log
*.py[cod]
node_modules/
spacetime/*/target/
__pycache__/

# Windows NUL device name — some tools accidentally create a tracked 'nul' file
nul

.octogent

# Local analysis reports produced during sessions (e.g. Grok token analysis)
grok-symforge-analysis-report.md
