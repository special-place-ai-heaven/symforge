+    #[cfg(feature = "embed")]
+    #[test]
+    fn bound_history_refuses_a_copied_state_identity() {
+        let temp = tempfile::tempdir().unwrap();
+        let db = temp.path().join("frecency.db");
+        let source_a = [1_u8; 16];
+        let source_b = [2_u8; 16];
+        let state_a = [3_u8; 16];
+        let state_b = [4_u8; 16];
+        let store = FrecencyStore::open(&db).unwrap();
+        store.bind_admitted_identity(source_a, state_a, true).unwrap();
+        store.bump(&[PathBuf::from("src/lib.rs")], 100).unwrap();
+        drop(store);
+        let reopened = FrecencyStore::open_existing_readonly(&db).unwrap().unwrap();
+        assert!(reopened.bind_admitted_identity(source_a, state_a, false).is_ok());
+        assert!(reopened.bind_admitted_identity(source_b, state_a, false).is_err());
+        assert!(reopened.bind_admitted_identity(source_a, state_b, false).is_err());
+    }
+
