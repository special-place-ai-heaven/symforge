+/// Commit against a cache entry bound to both admitted physical identities.
+/// `initialize` runs before the store becomes visible to concurrent callers;
+/// it must use a previously retained Git read view, never reacquire source
+/// authority while this cache lock is held. SQLite database, WAL, and SHM path
+/// operations rely on the selected state directory's protected host boundary;
+/// this identity check alone does not confine SQLite's pathname opens.
+#[cfg(feature = "embed")]
+pub(crate) fn bound_bump(
+    context: &BoundFrecencyContext<'_>,
+    paths: &[PathBuf],
+    initialize: impl FnOnce(&FrecencyStore) -> Result<(), String>,
+) -> Result<(), String> {
+    if paths.is_empty() {
+        return Ok(());
+    }
+    let policy = collection_policy_from_env();
+    let store = match policy {
+        crate::capability::FrecencyCollectionPolicy::Disabled => return Ok(()),
+        crate::capability::FrecencyCollectionPolicy::Session => bound_session_store(context)?,
+        crate::capability::FrecencyCollectionPolicy::Persistent => {
+            let key = context.persistent_key()?;
+            let mut cache = bound_persistent_cache()
+                .lock()
+                .map_err(|_| "bound frecency persistent cache is unavailable".to_string())?;
+            if let Some(existing) = cache.get(&key) {
+                Arc::clone(existing)
+            } else {
+                let opened = Arc::new(FrecencyStore::open(&key.db_path)
+                    .map_err(|_| "bound frecency persistent store is unavailable".to_string())?);
+                opened.bind_admitted_identity(key.source_key, key.state_key, true)?;
+                initialize(&opened)?;
+                // An admission change during SQLite open or HEAD initialization
+                // must never publish this connection into the bound cache.
+                if context.persistent_key()? != key {
+                    return Err("bound frecency admission changed before store publication".to_string());
+                }
+                cache.insert(key, Arc::clone(&opened));
+                opened
+            }
+        }
+    };
+    context.source_key()?;
+    if policy == crate::capability::FrecencyCollectionPolicy::Persistent {
+        context.persistent_key()?;
+    }
+    let now_ts = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|duration| duration.as_secs() as i64)
+        .unwrap_or(0);
+    store.bump(paths, now_ts).map_err(|_| "bound frecency bump failed".to_string())
+}
+
+/// Read existing native history without creating a persistent footprint.
+#[cfg(feature = "embed")]
+pub(crate) fn bound_ranking_scores_for_paths(
+    context: &BoundFrecencyContext<'_>,
+    paths: &[&Path],
+    now_ts: i64,
+) -> Result<Option<FrecencyRankingSnapshot>, String> {
+    let mut scores = HashMap::new();
+    let mut sources = Vec::new();
+    if context.project_state.is_some() && context.state_anchor.is_some() {
+        let key = context.persistent_key()?;
+        let cached = bound_persistent_cache()
+            .lock()
+            .map_err(|_| "bound frecency persistent cache is unavailable".to_string())?
+            .get(&key)
+            .cloned();
+        let store = if let Some(store) = cached {
+            Some(store)
+        } else {
+            FrecencyStore::open_existing_readonly(&key.db_path)
+                .map_err(|_| "bound frecency persistent history is unreadable".to_string())?
+                .map(Arc::new)
+        };
+        if let Some(store) = store {
+            store.bind_admitted_identity(key.source_key, key.state_key, false)?;
+            scores.extend(store.bulk_scores(paths, now_ts).map_err(|_| "bound frecency scores are unreadable".to_string())?);
+            sources.push("persistent");
+        }
+        if context.persistent_key()? != key {
+            return Err("bound frecency admission changed during ranking".to_string());
+        }
+    }
+    let session_key = BoundSessionKey {
+        repo_root: context.repo_root.to_path_buf(),
+        source_key: context.source_key()?,
+    };
+    if let Some(store) = bound_session_cache()
+        .lock()
+        .map_err(|_| "bound frecency session cache is unavailable".to_string())?
+        .get(&session_key)
+        .cloned()
+    {
+        scores.extend(store.bulk_scores(paths, now_ts).map_err(|_| "bound frecency session scores are unreadable".to_string())?);
+        sources.push("session");
+    }
+    context.source_key()?;
+    if sources.is_empty() {
+        return Ok(None);
+    }
+    Ok(Some(FrecencyRankingSnapshot {
+        scores,
+        source: format!("{} frecency history", sources.join(" + ")),
+    }))
+}
