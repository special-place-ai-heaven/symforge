+#[cfg(feature = "embed")]
+pub(crate) struct BoundFrecencyContext<'a> {
+    pub repo_root: &'a Path,
+    pub project_state: Option<&'a ProjectStateDir>,
+    pub source_authority: &'a ProjectSourceAuthority,
+    pub state_anchor: Option<(&'a PhysicalRootLease, [u8; 16])>,
+}
+
+#[cfg(feature = "embed")]
+#[derive(Clone, Hash, PartialEq, Eq)]
+struct BoundPersistentKey {
+    db_path: PathBuf,
+    repo_root: PathBuf,
+    source_key: [u8; 16],
+    state_key: [u8; 16],
+}
+
+#[cfg(feature = "embed")]
+#[derive(Clone, Hash, PartialEq, Eq)]
+struct BoundSessionKey {
+    repo_root: PathBuf,
+    source_key: [u8; 16],
+}
+
+#[cfg(feature = "embed")]
+impl BoundFrecencyContext<'_> {
+    fn source_key(&self) -> Result<[u8; 16], String> {
+        if self.source_authority.admitted_root() != self.repo_root {
+            return Err("bound frecency source root changed".to_string());
+        }
+        self.source_authority
+            .verify_physical_root_anchor()
+            .map_err(|_| "bound frecency source root is unavailable".to_string())?;
+        self.source_authority
+            .physical_root_stable_key()
+            .ok_or_else(|| "bound frecency source identity is unavailable".to_string())
+    }
+
+    fn persistent_key(&self) -> Result<BoundPersistentKey, String> {
+        let source_key = self.source_key()?;
+        let project_state = self
+            .project_state
+            .ok_or_else(|| "bound frecency persistent state is unavailable".to_string())?;
+        let (parked, state_key) = self
+            .state_anchor
+            .ok_or_else(|| "bound frecency state identity is unavailable".to_string())?;
+        let opened = parked
+            .reopened_matching_stable_key(state_key)
+            .map_err(|_| "bound frecency state directory changed".to_string())?;
+        if opened.root() != project_state.as_path() {
+            return Err("bound frecency state selection changed".to_string());
+        }
+        Ok(BoundPersistentKey {
+            db_path: frecency_db_path(project_state),
+            repo_root: self.repo_root.to_path_buf(),
+            source_key,
+            state_key,
+        })
+    }
+}
+
+#[cfg(feature = "embed")]
+fn hex_key(key: [u8; 16]) -> String {
+    key.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+#[cfg(feature = "embed")]
+fn bound_persistent_cache() -> &'static Mutex<HashMap<BoundPersistentKey, Arc<FrecencyStore>>> {
+    static CACHE: OnceLock<Mutex<HashMap<BoundPersistentKey, Arc<FrecencyStore>>>> = OnceLock::new();
+    CACHE.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+#[cfg(feature = "embed")]
+fn bound_session_cache() -> &'static Mutex<HashMap<BoundSessionKey, Arc<FrecencyStore>>> {
+    static CACHE: OnceLock<Mutex<HashMap<BoundSessionKey, Arc<FrecencyStore>>>> = OnceLock::new();
+    CACHE.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+#[cfg(feature = "embed")]
+fn bound_session_store(context: &BoundFrecencyContext<'_>) -> Result<Arc<FrecencyStore>, String> {
+    let key = BoundSessionKey {
+        repo_root: context.repo_root.to_path_buf(),
+        source_key: context.source_key()?,
+    };
+    let mut cache = bound_session_cache()
+        .lock()
+        .map_err(|_| "bound frecency session cache is unavailable".to_string())?;
+    if let Some(store) = cache.get(&key) {
+        return Ok(Arc::clone(store));
+    }
+    let store = Arc::new(FrecencyStore::open_in_memory().map_err(|_| "bound frecency session store is unavailable".to_string())?);
+    cache.insert(key, Arc::clone(&store));
+    Ok(store)
+}
