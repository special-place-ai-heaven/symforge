  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "stdio connects to a shared daemon via connect_or_spawn_session",
        "Most reads come from the published LiveIndex generation with no disk I/O"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Daemon HTTP is fail-closed Bearer on 127.0.0.1",
        "admit_disk_read and admit_git_text own the fetch; policy runs first"
      ]
    },
    {
      "dot": "violet",
      "title": "External dependencies",
      "items": [
        "rmcp 3.1, axum, notify, reqwest; tree-sitter parses into LiveIndex",
        "git2/libgit2 for the working tree; rusqlite for stel-ledger.db, not index.bin"
      ]
    }
  ]
